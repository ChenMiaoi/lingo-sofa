{
  "name": "lingo-sofa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @lingo-sofa/browser-extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "build": "npm run build --workspaces --if-present && npm run verify:extension",
    "dev": "npm run dev --workspace @lingo-sofa/browser-extension",
    "test:e2e": "playwright test",
    "verify:vencord": "node scripts/verify-vencord.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "benchmark": "tsx scripts/benchmark.mjs",
    "verify:real": "tsx scripts/verify-real-provider.mjs",
    "prepare:release": "npm run build && npm run package:native --workspace @lingo-sofa/pi-bridge && node scripts/prepare-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package:distribution": "node scripts/package-distribution.mjs",
    "package:windows": "tsx scripts/package-windows.mjs",
    "setup:discord": "node scripts/setup-discord.mjs",
    "verify:assistant": "node scripts/verify-assistant.mjs",
    "release:validate": "node scripts/release.mjs validate",
    "release:assemble": "node scripts/release.mjs assemble"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "pnpm": "11.28.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "GPL-3.0-or-later"
}
