{
  "name": "lingo-sofa",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "bun scripts/desktop.ts dev",
    "build": "bun scripts/desktop.ts build",
    "build:worker": "bun scripts/build-worker.ts",
    "build:web": "vite build --config apps/desktop/vite.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/runtime-report.test.ts tests/bundle-inputs.test.ts tests/ocr-assets.test.ts tests/build-worker.test.ts tests/dev-session.test.ts tests/release.test.ts tests/platform.test.ts tests/models.test.ts tests/subscription-login.test.ts tests/sdk/ipc.test.ts tests/sdk/compaction-lifecycle.test.ts tests/desktop.test.ts tests/desktop-interaction.test.ts tests/session-history.test.ts",
    "test:runtime": "bun tests/sdk/run-host.ts",
    "test:runtime:packaged": "bun tests/sdk/run-host.ts --packaged",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:runtime && cargo fmt --all --check && npm run build:worker && bun scripts/test-region-selector.ts && npm run build:web && cargo test --locked -p lingo-sofa-desktop -p lingo-sofa-ocr-helper && cargo clippy --workspace --all-targets -- -D warnings && cargo build --locked -p lingo-sofa-desktop",
    "verify:live": "bun --env-file=.env tests/sdk/run-live-host.ts --live",
    "verify:live:dual": "bun --env-file=.env tests/sdk/run-live-host.ts --live --dual",
    "test:sdk": "bun tests/sdk/run.ts",
    "verify:selection": "powershell.exe -NoProfile -STA -File tests/selection-system.ps1",
    "bundle": "bun scripts/bundle.ts",
    "signing:setup": "bun scripts/macos-signing.ts setup",
    "signing:verify": "bun scripts/verify-local-signing.ts",
    "app:local": "bun scripts/local-macos-app.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-coding-agent": "18.12.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "patchedDependencies": {
    "@oh-my-pi/pi-agent-core@18.12.3": "apps/omp-worker/patches/pi-agent-core-18.12.3.patch"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-win32-x64": "18.12.3",
    "@oh-my-pi/pi-natives-darwin-arm64": "18.12.3",
    "@oh-my-pi/pi-natives-darwin-x64": "18.12.3"
  }
}
